<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Vehicle | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: #f0f4ff;
        }

        .vehicle-form-card {
            background: #fff;
            border: 1px solid #e1e8f5;
            border-radius: 18px;
            box-shadow: 0 8px 28px rgba(30, 64, 175, 0.07);
        }

        .form-header {
            background: linear-gradient(120deg, #2563eb, #6366f1);
            color: white;
            padding: 25px;
            border-radius: 18px 18px 0 0;
        }

        .form-header p {
            color: #e0e7ff;
        }

        .form-label {
            color: #334155;
            font-weight: 600;
            font-size: 14px;
        }

        .form-control,
        .form-select {
            min-height: 44px;
            border: 1px solid #dbe3f0;
            border-radius: 9px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #6395f8;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .form-section-title {
            color: #334155;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .btn-add-vehicle {
            background: #2563eb;
            border-color: #2563eb;
            color: white;
            padding: 11px 22px;
            border-radius: 9px;
            font-weight: 600;
        }

        .btn-add-vehicle:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: white;
        }
    </style>
</head>

<body>

    <%- include("partials/navbar") %>

    <div class="container py-4 py-md-5">

        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">

                <a href="/vehicles"
                   class="btn btn-outline-secondary btn-sm mb-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to Vehicles
                </a>

                <div class="vehicle-form-card">

                    <div class="form-header">
                        <div class="d-flex align-items-center gap-3">
                            <div class="fs-1">
                                <i class="bi bi-car-front-fill"></i>
                            </div>

                            <div>
                                <h3 class="mb-1 fw-bold">Add New Vehicle</h3>
                                <p class="mb-0">
                                    Enter your vehicle details to get started.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 p-md-5">

                        <form action="/vehicles" method="POST">

                            <h6 class="form-section-title">
                                <i class="bi bi-info-circle text-primary me-2"></i>
                                Basic Information
                            </h6>

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label for="brand" class="form-label">Brand *</label>
                                    <input type="text" class="form-control"
                                           id="brand" name="brand"
                                           placeholder="e.g. Honda" required>
                                </div>

                                <div class="col-md-6">
                                    <label for="model" class="form-label">Model *</label>
                                    <input type="text" class="form-control"
                                           id="model" name="model"
                                           placeholder="e.g. City" required>
                                </div>

                                <div class="col-md-6">
                                    <label for="variant" class="form-label">Variant</label>
                                    <input type="text" class="form-control"
                                           id="variant" name="variant"
                                           placeholder="e.g. V CVT">
                                </div>

                                <div class="col-md-6">
                                    <label for="year" class="form-label">Manufacturing Year *</label>
                                    <input type="number" class="form-control"
                                           id="year" name="year"
                                           placeholder="e.g. 2023"
                                           min="1900" max="2100" required>
                                </div>

                                <div class="col-md-6">
                                    <label for="fuelType" class="form-label">Fuel Type *</label>
                                    <select class="form-select" id="fuelType"
                                            name="fuelType" required>
                                        <option value="">Select fuel type</option>
                                        <option value="Petrol">Petrol</option>
                                        <option value="Diesel">Diesel</option>
                                        <option value="CNG">CNG</option>
                                        <option value="Electric">Electric</option>
                                        <option value="Hybrid">Hybrid</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label for="transmission" class="form-label">Transmission *</label>
                                    <select class="form-select" id="transmission"
                                            name="transmission" required>
                                        <option value="">Select transmission</option>
                                        <option value="Manual">Manual</option>
                                        <option value="Automatic">Automatic</option>
                                        <option value="AMT">AMT</option>
                                        <option value="CVT">CVT</option>
                                        <option value="DCT">DCT</option>
                                    </select>
                                </div>

                            </div>

                            <hr class="my-4">

                            <h6 class="form-section-title">
                                <i class="bi bi-card-text text-primary me-2"></i>
                                Registration and Usage
                            </h6>

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label for="registrationNumber" class="form-label">
                                        Registration Number *
                                    </label>
                                    <input type="text" class="form-control"
                                           id="registrationNumber"
                                           name="registrationNumber"
                                           placeholder="e.g. MH12AB1234" required>
                                </div>

                                <div class="col-md-6">
                                    <label for="currentOdometer" class="form-label">
                                        Current Odometer (km) *
                                    </label>
                                    <input type="number" class="form-control"
                                           id="currentOdometer"
                                           name="currentOdometer"
                                           placeholder="e.g. 45000"
                                           min="0" required>
                                </div>

                                <div class="col-md-6">
                                    <label for="purchaseDate" class="form-label">
                                        Purchase Date
                                    </label>
                                    <input type="date" class="form-control"
                                           id="purchaseDate" name="purchaseDate">
                                </div>

                            </div>

                            <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                                <button type="submit" class="btn btn-add-vehicle">
                                    <i class="bi bi-plus-circle me-2"></i>
                                    Add Vehicle
                                </button>

                                <a href="/vehicles"
                                   class="btn btn-light border px-4">
                                    Cancel
                                </a>
                            </div>

                        </form>

                    </div>
                </div>

                <p class="text-muted small text-center mt-3">
                    Fields marked with * are required.
                </p>

            </div>
        </div>

    </div>

</body>
</html>
