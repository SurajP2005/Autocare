<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: #f3f6fc;
            display: flex;
            flex-direction: column;
        }

        /* Navbar */
        .navbar {
            padding: 16px 6%;
            background: white;
            border-bottom: 1px solid #e5eaf2;
        }

        .brand {
            color: #172554;
            font-size: 29px;
            font-weight: 800;
            text-decoration: none;
        }

        .brand span,
        .brand i {
            color: #2563eb;
        }

        /* Login layout */
        .login-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 35px 20px;
        }

        .login-card {
            width: 100%;
            max-width: 560px;
            padding: 32px 42px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        }

        .login-title {
            margin-bottom: 8px;
            color: #172554;
            font-size: 29px;
            font-weight: 750;
            text-align: center;
        }

        .login-subtitle {
            margin-bottom: 25px;
            color: #64748b;
            font-size: 15px;
            text-align: center;
        }

        /* Form */
        .form-label {
            color: #334155;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .form-control {
            min-height: 46px;
            padding: 10px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            font-size: 15px;
        }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .form-group {
            margin-bottom: 18px;
        }

        .login-button {
            width: 100%;
            min-height: 46px;
            margin-top: 5px;
            border: none;
            border-radius: 9px;
            background: #2563eb;
            color: white;
            font-size: 15px;
            font-weight: 650;
        }

        .login-button:hover {
            background: #1d4ed8;
            color: white;
        }

        .register-text {
            margin-top: 22px;
            margin-bottom: 0;
            color: #64748b;
            font-size: 14px;
            text-align: center;
        }

        .register-text a {
            color: #2563eb;
            font-weight: 650;
            text-decoration: none;
        }

        .register-text a:hover {
            text-decoration: underline;
        }

        .back-home {
            display: block;
            margin-top: 18px;
            color: #64748b;
            font-size: 14px;
            text-align: center;
            text-decoration: none;
        }

        .back-home:hover {
            color: #2563eb;
        }

        @media (max-width: 576px) {
            .navbar {
                padding: 14px 20px;
            }

            .brand {
                font-size: 25px;
            }

            .login-card {
                padding: 27px 22px;
            }

            .login-title {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <a href="/autocare" class="brand">
            <i class="bi bi-car-front-fill"></i>
            Auto<span>Care</span>
        </a>
    </nav>

    <main class="login-wrapper">
        <div>
            <div class="login-card">

                <h1 class="login-title">Welcome Back</h1>

                <p class="login-subtitle">
                    Login to manage your vehicle with AutoCare.
                </p>
                
                <% if (success && success.length > 0) { %>
                <div class="alert alert-success" role="alert">
                    <%= success[0] %>
                </div>
            <% } %>

            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error[0] %>
                </div>
            <% } %>

                <form action="/login" method="POST">

                    <div class="form-group">
                        <label for="username" class="form-label">
                            Username
                        </label>

                        <input
                            type="text"
                            id="username"
                            name="username"
                            class="form-control"
                            placeholder="Enter your username"
                            autocomplete="username"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">
                            Password
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required>
                    </div>

                    <button type="submit" class="btn login-button">
                        Login
                    </button>

                </form>

                <p class="register-text">
                    Don't have an account?
                    <a href="/register">Create an account</a>
                </p>

            </div>

            <a href="/autocare" class="back-home">
                <i class="bi bi-arrow-left"></i>
                Back to Home
            </a>
        </div>
    </main>

</body>
</html>
