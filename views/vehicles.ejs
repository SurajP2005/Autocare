<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Vehicles | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: #f5f7fb;
            color: #243247;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 28px;
        }

        .vehicle-card {
            background: #fff;
            border: 1px solid #e5eaf1;
            border-radius: 12px;
            padding: 24px;
            height: 100%;
            transition: box-shadow 0.2s ease;
        }

        .vehicle-card:hover {
            box-shadow: 0 6px 20px rgba(25, 45, 75, 0.08);
        }

        .vehicle-icon {
            width: 54px;
            height: 54px;
            border-radius: 10px;
            background: #eaf2ff;
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
        }

        .info-label {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .info-value {
            font-weight: 600;
            margin-bottom: 0;
        }

        .registration-box {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 12px;
        }
    </style>
</head>

<body>
    <%- include("partials/navbar") %>

    <main class="container py-5">

        <div class="page-header">
            <div>
                <h2 class="fw-bold mb-1">My Vehicles</h2>
                <p class="text-secondary mb-0">
                    A quick overview of all your vehicles.
                </p>
            </div>

            <a href="/newVehicle" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add Vehicle
            </a>
        </div>

        <% if (vehicles.length === 0) { %>

            <div class="bg-white rounded-3 border text-center p-5">
                <i class="bi bi-car-front display-4 text-secondary"></i>
                <h5 class="mt-3">No vehicles added yet</h5>
                <p class="text-secondary">
                    Add your first vehicle to get started.
                </p>
                <a href="/newVehicle" class="btn btn-primary">
                    Add Your First Vehicle
                </a>
            </div>

        <% } else { %>

            <div class="row g-4">

                <% vehicles.forEach(vehicle => { %>

                    <div class="col-md-6 col-xl-4">
                        <div class="vehicle-card">

                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="vehicle-icon">
                                    <i class="bi bi-car-front-fill"></i>
                                </div>

                                <div>
                                    <h5 class="fw-bold mb-1">
                                        <%= vehicle.brand %> <%= vehicle.model %>
                                    </h5>
                                    <span class="text-secondary small">
                                        Model year: <%= vehicle.year || "—" %>
                                    </span>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <p class="info-label">Fuel Type</p>
                                    <p class="info-value">
                                        <%= vehicle.fuelType || vehicle.fuel || "—" %>
                                    </p>
                                </div>

                                <div class="col-6">
                                    <p class="info-label">Odometer</p>
                                    <p class="info-value">
                                        <%= vehicle.currentOdometer ?? vehicle.odometer ?? 0 %> km
                                    </p>
                                </div>
                            </div>

                            <div class="registration-box mb-4">
                                <p class="info-label">Registration Number</p>
                                <p class="info-value">
                                    <%= vehicle.registrationNumber || vehicle.registration || "—" %>
                                </p>
                            </div>

                            <a href="/vehicles/<%= vehicle._id %>"
                               class="btn btn-outline-primary w-100">
                                View Vehicle Profile
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>
                    </div>

                <% }) %>

            </div>

        <% } %>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
