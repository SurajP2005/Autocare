<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Expense - AutoCare</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="expense-form-page">

    <%- include("partials/navbar") %>

    <div class="container py-5">

        <div class="expense-form-wrapper mx-auto">

            <!-- Header -->
            <div class="expense-form-header">
                <div class="expense-icon">
                    <i class="bi bi-wallet2"></i>
                </div>

                <h1>Add Expense</h1>

                <p>
                    Track your vehicle expenses and keep your spending organized.
                </p>
            </div>

            <!-- Expense Form -->
            <div class="expense-form-card">

                <form action="/expenses" method="POST">

                    <div class="row g-4">

                        <!-- Vehicle -->
                        <div class="col-md-6">
                            <label for="vehicleId" class="form-label">
                                <i class="bi bi-car-front me-1"></i>
                                Vehicle
                            </label>

                            <select
                                name="vehicleId"
                                id="vehicleId"
                                class="form-select"
                                required
                            >
                                <option value="">Select Vehicle</option>

                                <% vehicles.forEach(vehicle => { %>
                                    <option value="<%= vehicle._id %>">
                                        <%= vehicle.brand %> <%= vehicle.model %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Date -->
                        <div class="col-md-6">
                            <label for="date" class="form-label">
                                <i class="bi bi-calendar-event me-1"></i>
                                Expense Date
                            </label>

                            <input
                                type="date"
                                name="date"
                                id="date"
                                class="form-control"
                                required
                            >
                        </div>

                        <!-- Category -->
                        <div class="col-md-6">
                            <label for="category" class="form-label">
                                <i class="bi bi-tags me-1"></i>
                                Expense Category
                            </label>

                            <select
                                name="category"
                                id="category"
                                class="form-select"
                                required
                            >
                                <option value="">Select Category</option>
                                <option value="Fuel">Fuel</option>
                                <option value="Service">Service</option>
                                <option value="Repair">Repair</option>
                                <option value="Insurance">Insurance</option>
                                <option value="Tyres">Tyres</option>
                                <option value="Battery">Battery</option>
                                <option value="Parking">Parking</option>
                                <option value="Tolls">Tolls</option>
                                <option value="Accessories">Accessories</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <!-- Amount -->
                        <div class="col-md-6">
                            <label for="amount" class="form-label">
                                <i class="bi bi-currency-rupee me-1"></i>
                                Amount (₹)
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                min="0.01"
                                name="amount"
                                id="amount"
                                class="form-control"
                                placeholder="e.g. 1500"
                                required
                            >
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label for="description" class="form-label">
                                <i class="bi bi-card-text me-1"></i>
                                Description
                                <span class="text-muted">(Optional)</span>
                            </label>

                            <textarea
                                name="description"
                                id="description"
                                class="form-control"
                                rows="3"
                                placeholder="Describe the expense..."
                            ></textarea>
                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="expense-form-actions">

                        <a href="/expenses" class="btn cancel-expense-btn">
                            <i class="bi bi-arrow-left me-1"></i>
                            Cancel
                        </a>

                        <button type="submit" class="btn submit-expense-btn">
                            <i class="bi bi-check-circle me-1"></i>
                            Add Expense
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>
</html>
