<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fuel History | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("partials/navbar") %>

    <div class="container mt-4">

        <a href="/vehicles/<%= vehicle._id %>" class="btn btn-outline-secondary btn-sm mb-3">
            Back to Vehicle
        </a>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Fuel History</h3>
            <a href="/fuel" class="btn btn-primary">Add Fuel</a>
        </div>

        <h5 class="text-muted mb-3">
            <%= vehicle.brand %> <%= vehicle.model %>
        </h5>

        <div class="mb-4">
            <p><strong>Total Fuel Spending:</strong> ₹<%= Number(totalFuelCost || 0).toFixed(2) %></p>
            <p><strong>Fuel Cost per KM:</strong> ₹<%= Number(fuelCostPerKm || 0).toFixed(2) %></p>
<p><strong>Average Mileage:</strong> <%= Number(typeof mileage !== "undefined" ? mileage : 0).toFixed(2) %> km/l</p>
        </div>

        <% if (fuels.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Odometer</th>
                            <th>Fuel</th>
                            <th>Amount</th>
                            <th>Station</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% fuels.forEach(fuel => { %>
                            <tr>
                                <td>
                                    <%= fuel.date ? new Date(fuel.date).toLocaleDateString("en-IN") : "-" %>
                                </td>
                                <td><%= fuel.odometer || 0 %> km</td>
                                <td><%= fuel.litres || fuel.fuelAmount || 0 %> litres</td>
                                <td>₹<%= Number(fuel.amount || 0).toFixed(2) %></td>
                                <td><%= fuel.station || "-" %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="alert alert-info">
                No fuel records found. Click "Add Fuel" to add your first record.
            </div>
        <% } %>

    </div>

</body>
</html>