<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vehicle Profile | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: #f5f7fb;
            color: #243247;
        }

        .profile-card, .module-card {
            background: #fff;
            border: 1px solid #e5eaf1;
            border-radius: 12px;
        }

        .profile-card {
            padding: 28px;
        }

        .vehicle-icon, .module-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #eaf2ff;
            color: #0d6efd;
        }

        .vehicle-icon {
            width: 62px;
            height: 62px;
            font-size: 32px;
        }

        .module-icon {
            width: 46px;
            height: 46px;
            font-size: 23px;
            flex-shrink: 0;
        }

        .detail-label {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .detail-value {
            font-weight: 600;
            margin-bottom: 0;
            overflow-wrap: anywhere;
        }

        .module-card {
            padding: 22px;
            height: 100%;
            transition: box-shadow 0.2s ease;
        }

        .module-card:hover {
            box-shadow: 0 6px 18px rgba(25, 45, 75, 0.07);
        }

        .module-card p {
            color: #6c757d;
            font-size: 14px;
            min-height: 42px;
        }
    </style>
</head>

<body>
    <%- include("partials/navbar") %>

    <main class="container py-5">

        <div class="mb-4">
            <a href="/vehicles" class="text-decoration-none">
                <i class="bi bi-arrow-left"></i> Back to My Vehicles
            </a>
        </div>

        <!-- VEHICLE PROFILE -->
        <section class="profile-card mb-4">

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="vehicle-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </div>

                    <div>
                        <h2 class="fw-bold mb-1">
                            <%= vehicle.brand %> <%= vehicle.model %>
                        </h2>
                        <p class="text-secondary mb-0">
                            <%= vehicle.variant || "Vehicle Profile" %>
                        </p>
                    </div>
                </div>

                <a href="/vehicles/<%= vehicle._id %>/edit"
                   class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Vehicle
                </a>
            </div>

            <hr class="my-4">

            <div class="row g-4">
                <div class="col-6 col-lg-3">
                    <p class="detail-label">Model Year</p>
                    <p class="detail-value"><%= vehicle.year || "—" %></p>
                </div>

                <div class="col-6 col-lg-3">
                    <p class="detail-label">Fuel Type</p>
                    <p class="detail-value">
                        <%= vehicle.fuelType || vehicle.fuel || "—" %>
                    </p>
                </div>

                <div class="col-6 col-lg-3">
                    <p class="detail-label">Transmission</p>
                    <p class="detail-value"><%= vehicle.transmission || "—" %></p>
                </div>

                <div class="col-6 col-lg-3">
                    <p class="detail-label">Current Odometer</p>
                    <p class="detail-value">
                        <%= vehicle.currentOdometer ?? vehicle.odometer ?? 0 %> km
                    </p>
                </div>

                <div class="col-12 col-md-6">
                    <p class="detail-label">Registration Number</p>
                    <p class="detail-value">
                        <%= vehicle.registrationNumber || vehicle.registration || "—" %>
                    </p>
                </div>

                <div class="col-12 col-md-6">
                    <p class="detail-label">Purchase Date</p>
                    <p class="detail-value">
                        <%= vehicle.purchaseDate
                            ? new Date(vehicle.purchaseDate).toLocaleDateString("en-IN", {
                                day: "2-digit",
                                month: "short",
                                year: "numeric"
                            })
                            : "—" %>
                    </p>
                </div>
            </div>

            <hr class="my-4">

            <form action="/vehicles/<%= vehicle._id %>/delete"
                  method="POST"
                  onsubmit="return confirm('Are you sure you want to delete this vehicle? Related records may also be affected.');">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i> Delete Vehicle
                </button>
            </form>
        </section>

        <!-- VEHICLE MANAGEMENT MODULES -->
        <div class="mb-3">
            <h4 class="fw-bold mb-1">Vehicle Management</h4>
            <p class="text-secondary">
                Manage all records associated with this vehicle.
            </p>
        </div>

        <div class="row g-3">

            <div class="col-md-6 col-xl-4">
                <div class="module-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon"><i class="bi bi-tools"></i></div>
                        <h5 class="fw-bold mb-0">Service History</h5>
                    </div>
                    <p>View servicing, repairs and maintenance costs.</p>
                    <a href="/services/history/<%= vehicle._id %>"
                       class="btn btn-outline-primary btn-sm">
                        View Services <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                    <a href="/services" class="btn btn-primary btn-sm ms-1">
                        Add Service
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="module-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon"><i class="bi bi-fuel-pump"></i></div>
                        <h5 class="fw-bold mb-0">Fuel Tracking</h5>
                    </div>
                    <p>Track refuelling, fuel spending and mileage.</p>
                    <a href="/fuel/history/<%= vehicle._id %>"
                       class="btn btn-outline-primary btn-sm">
                        View Fuel History
                    </a>
                    <a href="/fuel" class="btn btn-primary btn-sm ms-1">
                        Add Fuel
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="module-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon"><i class="bi bi-wallet2"></i></div>
                        <h5 class="fw-bold mb-0">Expenses</h5>
                    </div>
                    <p>Review other vehicle-related spending.</p>
                    <a href="/expenses/history/<%= vehicle._id %>"
                       class="btn btn-outline-primary btn-sm">
                        View Expenses
                    </a>
                    <a href="/expenses" class="btn btn-primary btn-sm ms-1">
                        Add Expense
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="module-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon"><i class="bi bi-bell"></i></div>
                        <h5 class="fw-bold mb-0">Maintenance</h5>
                    </div>
                    <p>Manage upcoming maintenance and reminders.</p>
                    <a href="/maintenance/history/<%= vehicle._id %>"
                       class="btn btn-outline-primary btn-sm">
                        View Reminders
                    </a>
                    <a href="/maintenance" class="btn btn-primary btn-sm ms-1">
                        Add Reminder
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="module-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon"><i class="bi bi-file-earmark-text"></i></div>
                        <h5 class="fw-bold mb-0">Documents</h5>
                    </div>
                    <p>Keep insurance, registration and other documents organised.</p>
                    <a href="/documents/history/<%= vehicle._id %>"
                       class="btn btn-outline-primary btn-sm">
                        View Documents
                    </a>
                    <a href="/documents" class="btn btn-primary btn-sm ms-1">
                        Add Document
                    </a>
                </div>
            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
