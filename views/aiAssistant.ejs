
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoCare AI Assistant</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>
        .ai-page {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 16px;
        }

        .ai-header {
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: white;
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 24px;
        }

        .ai-card {
            background: white;
            padding: 28px;
            border-radius: 18px;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
            margin-bottom: 24px;
        }

        .ai-response {
            background: #f5f7ff;
            border-left: 4px solid #6366f1;
            padding: 20px;
            border-radius: 12px;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .ai-response-title {
            color: #4338ca;
            font-weight: 700;
        }

        .ai-submit {
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            border: none;
            color: white;
            border-radius: 10px;
            padding: 12px 22px;
        }

        .ai-submit:hover {
            color: white;
            opacity: 0.9;
        }

        .ai-icon {
            font-size: 34px;
        }
        .ai-response {
    background: #f5f7ff;
    border-left: 4px solid #6366f1;
    padding: 24px;
    border-radius: 12px;
    line-height: 1.8;
    overflow-wrap: anywhere;
}

.ai-response h1,
.ai-response h2,
.ai-response h3 {
    color: #4338ca;
    margin-top: 20px;
    margin-bottom: 12px;
    font-weight: 700;
}

.ai-response ul,
.ai-response ol {
    padding-left: 24px;
    margin-bottom: 16px;
}

.ai-response p {
    margin-bottom: 14px;
}

.ai-response strong {
    color: #1e293b;
}
    </style>
</head>

<body>

    <%- include("partials/navbar") %>

    <main class="ai-page">

        <section class="ai-header">
            <div class="ai-icon mb-2">🤖</div>
            <h1 class="h2 fw-bold">AutoCare AI Assistant</h1>
            <p class="mb-0">
                Get personalized vehicle maintenance guidance based on
                your service history, fuel records, expenses, and reminders.
            </p>
        </section>

        <section class="ai-card">

            <h2 class="h4 fw-bold mb-4">Ask about your vehicle</h2>

            <% if (error) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <% if (vehicles.length === 0) { %>

                <div class="alert alert-info">
                    You haven't added a vehicle yet.
                    <a href="/newVehicle">Add your first vehicle</a>
                    to start using AutoCare AI.
                </div>

            <% } else { %>

                <form action="/ai-assistant" method="POST">

                    <div class="mb-4">
                        <label for="vehicleId" class="form-label fw-semibold">
                            Select vehicle
                        </label>

                        <select
                            class="form-select"
                            id="vehicleId"
                            name="vehicleId"
                            required
                        >
                            <option value="">Choose a vehicle</option>

                            <% vehicles.forEach(vehicle => { %>
                                <option
                                    value="<%= vehicle._id %>"
                                    <%= String(selectedVehicleId) === String(vehicle._id) ? "selected" : "" %>
                                >
                                    <%= vehicle.brand %> <%= vehicle.model %>
                                    <% if (vehicle.year) { %>
                                        (<%= vehicle.year %>)
                                    <% } %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="question" class="form-label fw-semibold">
                            Your question
                        </label>

                        <textarea
                            class="form-control"
                            id="question"
                            name="question"
                            rows="4"
                            maxlength="1000"
                            placeholder="Example: What maintenance should I prioritize next?"
                            required
                        ><%= question %></textarea>

                        <div class="form-text">
                            Ask about maintenance, service history, fuel usage,
                            or vehicle expenses. Maximum 1000 characters.
                        </div>
                    </div>

                    <button type="submit" class="btn ai-submit">
                        ✨ Ask AutoCare AI
                    </button>

                </form>

            <% } %>

        </section>

        <% if (aiResponse) { %>

            <section class="ai-card">

                <h2 class="h4 ai-response-title mb-3">
                    ✨ AutoCare AI's Response
                </h2>

    <div id="aiResponse" class="ai-response"></div>

                <p class="text-muted small mt-3 mb-0">
                    AI-generated guidance may be incomplete. Verify
                    maintenance recommendations with your vehicle manual
                    or a qualified mechanic, especially for safety issues.
                </p>

            </section>

        <% } %>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>

<script>
    const aiResponse = <%- JSON.stringify(aiResponse || "") %>;

const parsedHtml = marked.parse(
    aiResponse.replace(/&#x20;/gi, " ")
);

    document.getElementById("aiResponse").innerHTML =
        DOMPurify.sanitize(parsedHtml);
</script>

</body>
</html>
