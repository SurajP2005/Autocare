<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Fuel - AutoCare</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="fuel-form-page">

    <%- include("partials/navbar") %>

    <div class="container py-5">

        <div class="fuel-form-wrapper mx-auto">

            <!-- Page Header -->
            <div class="fuel-form-header">
                <div class="fuel-icon">
                    <i class="bi bi-fuel-pump-fill"></i>
                </div>

                <h1>Add Fuel Record</h1>

                <p>
                    Track your fuel purchases and monitor your vehicle's fuel expenses.
                </p>
            </div>

            
        <% if (success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success[0] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error[0] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>


            <!-- Fuel Form -->
            <div class="fuel-form-card">

                <form action="/fuel" method="POST">

                    <div class="row g-4">

                        <!-- Vehicle -->
                        <div class="col-md-6">
                            <label for="vehicleId" class="form-label">
                                <i class="bi bi-car-front me-1"></i>
                                Vehicle
                            </label>

                            <select
                                name="vehicleId"
                                id="vehicleId"
                                class="form-select"
                                required
                            >
                                <option value="">Select Vehicle</option>

                                <% vehicles.forEach(vehicle => { %>
                                    <option value="<%= vehicle._id %>">
                                        <%= vehicle.brand %> <%= vehicle.model %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Date -->
                        <div class="col-md-6">
                            <label for="date" class="form-label">
                                <i class="bi bi-calendar-event me-1"></i>
                                Fuel Date
                            </label>

                            <input
                                type="date"
                                name="date"
                                id="date"
                                class="form-control"
                                required
                            >
                        </div>

                        <!-- Odometer -->
                        <div class="col-md-6">
                            <label for="odometer" class="form-label">
                                <i class="bi bi-speedometer2 me-1"></i>
                                Odometer (km)
                            </label>

                            <input
                                type="number"
                                name="odometer"
                                id="odometer"
                                class="form-control"
                                placeholder="e.g. 45000"
                                min="0"
                                required
                            >
                        </div>

                        <!-- Litres -->
                        <div class="col-md-6">
                            <label for="litres" class="form-label">
                                <i class="bi bi-droplet-half me-1"></i>
                                Fuel Quantity (Litres)
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                name="litres"
                                id="litres"
                                class="form-control"
                                placeholder="e.g. 25.50"
                                min="0.01"
                                required
                            >
                        </div>

                        <!-- Amount -->
                        <div class="col-md-6">
                            <label for="amount" class="form-label">
                                <i class="bi bi-currency-rupee me-1"></i>
                                Total Amount (₹)
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                name="amount"
                                id="amount"
                                class="form-control"
                                placeholder="e.g. 2500"
                                min="0"
                                required
                            >
                        </div>

                        <!-- Fuel Station -->
                        <div class="col-md-6">
                            <label for="station" class="form-label">
                                <i class="bi bi-geo-alt me-1"></i>
                                Fuel Station
                                <span class="text-muted">(Optional)</span>
                            </label>

                            <input
                                type="text"
                                name="station"
                                id="station"
                                class="form-control"
                                placeholder="Enter fuel station name"
                            >
                        </div>

                        <!-- Full Tank Checkbox -->
                        <div class="col-12">
                            <div class="form-check">
                                <input
                                    type="checkbox"
                                    name="fullTank"
                                    id="fullTank"
                                    value="true"
                                    class="form-check-input"
                                >

                                <label
                                    for="fullTank"
                                    class="form-check-label"
                                >
                                    <i class="bi bi-fuel-pump me-1"></i>
                                    Tank filled completely?
                                </label>
                            </div>

                            <small class="text-muted d-block mt-2">
                                Check this only when you fill the tank completely.
                                Leave it unchecked for a partial refill.
                            </small>
                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="fuel-form-actions">
                        <a href="/fuel" class="btn btn-light cancel-btn">
                            <i class="bi bi-arrow-left me-1"></i>
                            Cancel
                        </a>

                        <button type="submit" class="btn add-fuel-btn">
                            <i class="bi bi-check-circle me-1"></i>
                            Add Fuel Record
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</body>
</html>
