<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Maintenance Reminder | AutoCare</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="maintenance-form-page">

    <%- include("partials/navbar") %>

    <div class="container py-5">

        <div class="maintenance-form-wrapper mx-auto">

            <!-- Header -->
            <div class="maintenance-form-header">
                <div class="maintenance-icon">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>

                <h1>Add Maintenance Reminder</h1>

                <p>
                    Stay on top of upcoming servicing and keep your vehicle in good condition.
                </p>
            </div>

            <!-- Form Card -->
            <div class="maintenance-form-card">

                <form action="/maintenance" method="POST">

                    <div class="row g-4">

                        <!-- Vehicle -->
                        <div class="col-md-6">
                            <label for="vehicleId" class="form-label">
                                <i class="bi bi-car-front me-1"></i>
                                Select Vehicle
                            </label>

                            <select
                                name="vehicleId"
                                id="vehicleId"
                                class="form-select"
                                required
                            >
                                <option value="">Choose your vehicle</option>

                                <% vehicles.forEach(vehicle => { %>
                                    <option value="<%= vehicle._id %>">
                                        <%= vehicle.brand %> <%= vehicle.model %> (<%= vehicle.year %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Maintenance Title -->
                        <div class="col-md-6">
                            <label for="title" class="form-label">
                                <i class="bi bi-card-heading me-1"></i>
                                Maintenance Title
                            </label>

                            <input
                                type="text"
                                name="title"
                                id="title"
                                class="form-control"
                                placeholder="e.g. Engine Oil Change"
                                required
                            >
                        </div>

                        <!-- Maintenance Type -->
                        <div class="col-md-6">
                            <label for="maintenanceType" class="form-label">
                                <i class="bi bi-tools me-1"></i>
                                Maintenance Type
                            </label>

                            <select
                                name="maintenanceType"
                                id="maintenanceType"
                                class="form-select"
                                required
                            >
                                <option value="">Select type</option>
                                <option value="Periodic Service">Periodic Service</option>
                                <option value="Engine Oil">Engine Oil</option>
                                <option value="Tyre Check">Tyre Check</option>
                                <option value="Brake Inspection">Brake Inspection</option>
                                <option value="Battery Check">Battery Check</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <!-- Due Date -->
                        <div class="col-md-6">
                            <label for="dueDate" class="form-label">
                                <i class="bi bi-calendar-event me-1"></i>
                                Due Date
                                <span class="text-muted">(Optional)</span>
                            </label>

                            <input
                                type="date"
                                name="dueDate"
                                id="dueDate"
                                class="form-control"
                            >
                        </div>

                        <!-- Due Odometer -->
                        <div class="col-md-6">
                            <label for="dueOdometer" class="form-label">
                                <i class="bi bi-speedometer2 me-1"></i>
                                Due Odometer (km)
                                <span class="text-muted">(Optional)</span>
                            </label>

                            <input
                                type="number"
                                name="dueOdometer"
                                id="dueOdometer"
                                class="form-control"
                                min="0"
                                placeholder="e.g. 10000"
                            >
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label for="description" class="form-label">
                                <i class="bi bi-card-text me-1"></i>
                                Description
                                <span class="text-muted">(Optional)</span>
                            </label>

                            <textarea
                                name="description"
                                id="description"
                                class="form-control"
                                rows="3"
                                placeholder="Add any additional maintenance details..."
                            ></textarea>
                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="maintenance-form-actions">

                        <a href="/dashboard" class="btn cancel-maintenance-btn">
                            <i class="bi bi-arrow-left me-1"></i>
                            Cancel
                        </a>

                        <button type="submit" class="btn save-maintenance-btn">
                            <i class="bi bi-check-circle me-1"></i>
                            Save Reminder
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>
</html>
