<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Vehicle | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: #f3f6fc;
            color: #24324b;
        }

        .navbar {
            padding: 16px 6%;
            background: white;
            border-bottom: 1px solid #e5eaf2;
        }

        .brand {
            color: #172554;
            font-size: 29px;
            font-weight: 800;
            text-decoration: none;
        }

        .brand i,
        .brand span {
            color: #2563eb;
        }

        .page-wrapper {
            max-width: 1000px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .page-heading {
            margin-bottom: 22px;
        }

        .page-heading h1 {
            margin-bottom: 7px;
            color: #172554;
            font-size: 29px;
            font-weight: 750;
        }

        .page-heading p {
            margin: 0;
            color: #64748b;
            font-size: 15px;
        }

        .form-card {
            padding: 32px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        }

        .form-label {
            margin-bottom: 7px;
            color: #334155;
            font-size: 14px;
            font-weight: 600;
        }

        .form-control,
        .form-select {
            min-height: 45px;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            background-color: #fff;
            color: #24324b;
            font-size: 14px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .form-actions {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid #edf1f7;
        }

        .form-actions .btn {
            min-height: 44px;
            padding: 10px 20px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 600;
        }

        .save-button {
            border: none;
            background: #2563eb;
            color: white;
        }

        .save-button:hover {
            background: #1d4ed8;
            color: white;
        }

        .cancel-button {
            border: 1px solid #cbd5e1;
            background: white;
            color: #475569;
        }

        .cancel-button:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

        @media (max-width: 576px) {
            .navbar {
                padding: 14px 20px;
            }

            .brand {
                font-size: 25px;
            }

            .page-wrapper {
                margin-top: 24px;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .form-card {
                padding: 22px 18px;
            }

            .form-actions {
                flex-direction: column-reverse;
            }

            .form-actions .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- AutoCare Brand -->
    <nav class="navbar">
        <a href="/autocare" class="brand">
            <i class="bi bi-car-front-fill"></i>
            Auto<span>Care</span>
        </a>
    </nav>

    <main class="page-wrapper">

        <div class="page-heading">
            <h1>
                <i class="bi bi-pencil-square text-primary me-2"></i>
                Edit Vehicle
            </h1>
            <p>Update your vehicle information and specifications.</p>
        </div>

        <div class="form-card">

            <form action="/vehicles/<%= vehicle._id %>/edit" method="POST">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="brand" class="form-label">Brand</label>
                        <input type="text" id="brand" name="brand"
                               class="form-control"
                               value="<%= vehicle.brand %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="model" class="form-label">Model</label>
                        <input type="text" id="model" name="model"
                               class="form-control"
                               value="<%= vehicle.model %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="variant" class="form-label">Variant</label>
                        <input type="text" id="variant" name="variant"
                               class="form-control"
                               value="<%= vehicle.variant %>">
                    </div>

                    <div class="col-md-6">
                        <label for="year" class="form-label">Year</label>
                        <input type="number" id="year" name="year"
                               class="form-control"
                               value="<%= vehicle.year %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="fuelType" class="form-label">Fuel Type</label>
                        <select id="fuelType" name="fuelType"
                                class="form-select" required>
                            <option value="Petrol" <%= vehicle.fuelType === "Petrol" ? "selected" : "" %>>Petrol</option>
                            <option value="Diesel" <%= vehicle.fuelType === "Diesel" ? "selected" : "" %>>Diesel</option>
                            <option value="CNG" <%= vehicle.fuelType === "CNG" ? "selected" : "" %>>CNG</option>
                            <option value="Electric" <%= vehicle.fuelType === "Electric" ? "selected" : "" %>>Electric</option>
                            <option value="Hybrid" <%= vehicle.fuelType === "Hybrid" ? "selected" : "" %>>Hybrid</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="transmission" class="form-label">Transmission</label>
                        <select id="transmission" name="transmission"
                                class="form-select" required>
                            <option value="Manual" <%= vehicle.transmission === "Manual" ? "selected" : "" %>>Manual</option>
                            <option value="Automatic" <%= vehicle.transmission === "Automatic" ? "selected" : "" %>>Automatic</option>
                            <option value="AMT" <%= vehicle.transmission === "AMT" ? "selected" : "" %>>AMT</option>
                            <option value="CVT" <%= vehicle.transmission === "CVT" ? "selected" : "" %>>CVT</option>
                            <option value="DCT" <%= vehicle.transmission === "DCT" ? "selected" : "" %>>DCT</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="registrationNumber" class="form-label">Registration Number</label>
                        <input type="text" id="registrationNumber"
                               name="registrationNumber"
                               class="form-control"
                               value="<%= vehicle.registrationNumber %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="currentOdometer" class="form-label">Current Odometer (km)</label>
                        <input type="number" id="currentOdometer"
                               name="currentOdometer"
                               class="form-control"
                               min="0"
                               value="<%= vehicle.currentOdometer %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="purchaseDate" class="form-label">Purchase Date</label>
                        <input type="date" id="purchaseDate"
                               name="purchaseDate"
                               class="form-control"
                               value="<%= vehicle.purchaseDate ? vehicle.purchaseDate.toISOString().split('T')[0] : '' %>">
                    </div>

                </div>

                <div class="form-actions">
                    <a href="/vehicles" class="btn cancel-button">
                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn save-button">
                        <i class="bi bi-check2-circle me-1"></i>
                        Update Vehicle
                    </button>
                </div>

            </form>

        </div>

    </main>

</body>
</html>
