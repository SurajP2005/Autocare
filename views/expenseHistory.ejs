
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expense History | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("partials/navbar") %>

    <div class="container mt-4">

        <a href="/vehicles/<%= vehicle._id %>" class="btn btn-outline-secondary btn-sm mb-3">
            Back to Vehicle
        </a>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Expense History</h3>
            <a href="/expenses" class="btn btn-primary">Add Expense</a>
        </div>

        <h5 class="text-muted mb-3">
            <%= vehicle.brand %> <%= vehicle.model %>
        </h5>

        <p class="mb-4">
            <strong>Total Expenses:</strong>
            ₹<%= Number(totalExpense || 0).toFixed(2) %>
        </p>

        <% if (expenses.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% expenses.forEach(expense => { %>
                            <tr>
                                <td>
                                    <%= expense.date ? new Date(expense.date).toLocaleDateString("en-IN") : "-" %>
                                </td>
                                <td><%= expense.category || "-" %></td>
                                <td>₹<%= Number(expense.amount || 0).toFixed(2) %></td>
                                <td><%= expense.description || "-" %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="alert alert-info">
                No expenses found. Click "Add Expense" to add your first record.
            </div>
        <% } %>

    </div>

</body>
</html>
