<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service History | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("partials/navbar") %>

    <div class="container mt-4">
        <a href="/vehicles/<%= vehicle._id %>" class="btn btn-outline-secondary btn-sm mb-3">
            Back to Vehicle
        </a>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Service History</h3>
            <a href="/services" class="btn btn-primary">Add Service</a>
        </div>

        <p class="text-muted">
            <%= vehicle.brand %> <%= vehicle.model %>
        </p>

        <% if (services.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Service</th>
                            <th>Date</th>
                            <th>Cost</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% services.forEach(service => { %>
                            <tr>
                                <td>
                                    <%= service.serviceType || service.title || service.description || "Vehicle Service" %>
                                </td>

                                <td>
                                    <%= service.date ? new Date(service.date).toLocaleDateString("en-IN") : "-" %>
                                </td>

                                <td>₹<%= service.cost || 0 %></td>

                                <td>
                                    <a href="/services/<%= service._id %>/edit"
                                       class="btn btn-sm btn-warning">Edit</a>

                                    <form action="/services/<%= service._id %>/delete"
                                          method="POST" class="d-inline"
                                          onsubmit="return confirm('Delete this service?')">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="alert alert-info">
                No service records found. Click "Add Service" to add one.
            </div>
        <% } %>
    </div>

</body>
</html>
