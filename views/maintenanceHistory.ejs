
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maintenance History | AutoCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">

    <h2><%= vehicle.brand %> <%= vehicle.model %> — Maintenance</h2>

    <a href="/maintenance" class="btn btn-primary my-3">
        Add Reminder
    </a>

    <% if (maintenances.length === 0) { %>
        <div class="alert alert-info">
            No maintenance reminders found for this vehicle.
        </div>
    <% } else { %>

        <div class="table-responsive">
            <table class="table table-bordered table-striped bg-white">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Due Date</th>
                        <th>Due Odometer</th>
                        <th>Status</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% maintenances.forEach(maintenance => { %>
                        <tr>
                            <td><%= maintenance.title %></td>
                            <td><%= maintenance.maintenanceType %></td>
                            <td>
                                <%= maintenance.dueDate
                                    ? new Date(maintenance.dueDate).toLocaleDateString("en-IN")
                                    : "Not set" %>
                            </td>
                            <td>
                                <%= maintenance.dueOdometer != null
                                    ? maintenance.dueOdometer + " km"
                                    : "Not set" %>
                            </td>
                            <td>
                                <span class="badge bg-primary">
                                    <%= maintenance.status %>
                                </span>
                            </td>
                            <td><%= maintenance.description || "-" %></td>
                            

            <td>
                <% if (maintenance.status !== "Completed") { %>
                    <form action="/maintenance/<%= maintenance._id %>/complete"
                        method="POST"
                        class="d-inline"
                        onsubmit="return confirm('Mark this maintenance as completed?');">

                        <button type="submit" class="btn btn-sm btn-success">
                            Mark Completed
                        </button>
                    </form>
                <% } else { %>
                    <span class="badge bg-success">Completed</span>
                <% } %>

                <a href="/maintenance/<%= maintenance._id %>/edit"
                class="btn btn-sm btn-warning">
                    Edit
                </a>

                <form action="/maintenance/<%= maintenance._id %>/delete"
                    method="POST"
                    class="d-inline"
                    onsubmit="return confirm('Delete this reminder?');">

                    <button type="submit" class="btn btn-sm btn-danger">
                        Delete
                    </button>
                </form>
        </td>

                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

    <% } %>

    <a href="/vehicles" class="btn btn-secondary">Back to Vehicles</a>

</div>

</body>
</html>
