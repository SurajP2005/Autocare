<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Service | AutoCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: #f3f6fc;
            color: #24324b;
        }

        .navbar {
            padding: 16px 6%;
            background: #fff;
            border-bottom: 1px solid #e5eaf2;
        }

        .brand {
            color: #172554;
            font-size: 29px;
            font-weight: 800;
            text-decoration: none;
        }

        .brand i,
        .brand span {
            color: #2563eb;
        }

        .page-wrapper {
            max-width: 900px;
            margin: 38px auto;
            padding: 0 20px;
        }

        .page-heading {
            margin-bottom: 24px;
        }

        .page-heading h1 {
            margin-bottom: 8px;
            color: #172554;
            font-size: 29px;
            font-weight: 750;
        }

        .page-heading p {
            margin: 0;
            color: #64748b;
            font-size: 15px;
        }

        .form-card {
            padding: 32px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        }

        .form-label {
            margin-bottom: 7px;
            color: #334155;
            font-size: 14px;
            font-weight: 600;
        }

        .form-control {
            min-height: 45px;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            font-size: 14px;
        }

        textarea.form-control {
            min-height: 90px;
            resize: vertical;
        }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .form-actions {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid #edf1f7;
        }

        .form-actions .btn {
            min-height: 44px;
            padding: 10px 20px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 600;
        }

        .save-button {
            border: none;
            background: #2563eb;
            color: #fff;
        }

        .save-button:hover {
            background: #1d4ed8;
            color: #fff;
        }

        .cancel-button {
            border: 1px solid #cbd5e1;
            background: #fff;
            color: #475569;
        }

        .cancel-button:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

        @media (max-width: 576px) {
            .navbar {
                padding: 14px 20px;
            }

            .brand {
                font-size: 25px;
            }

            .page-wrapper {
                margin-top: 25px;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .form-card {
                padding: 22px 18px;
            }

            .form-actions {
                flex-direction: column-reverse;
            }

            .form-actions .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- AutoCare Brand -->
    <nav class="navbar">
        <a href="/autocare" class="brand">
            <i class="bi bi-car-front-fill"></i>
            Auto<span>Care</span>
        </a>
    </nav>

    <main class="page-wrapper">

        <div class="page-heading">
            <h1>
                <i class="bi bi-wrench-adjustable text-primary me-2"></i>
                Edit Service
            </h1>
            <p>Update your vehicle's service and maintenance details.</p>
        </div>

        <div class="form-card">

            <form action="/services/<%= service._id %>/edit" method="POST">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="date" class="form-label">Service Date</label>
                        <input
                            type="date"
                            id="date"
                            name="date"
                            class="form-control"
                            value="<%= service.date.toISOString().split('T')[0] %>"
                            required>
                    </div>

                    <div class="col-md-6">
                        <label for="odometer" class="form-label">Odometer (km)</label>
                        <input
                            type="number"
                            id="odometer"
                            name="odometer"
                            class="form-control"
                            min="0"
                            value="<%= service.odometer %>"
                            required>
                    </div>

                    <div class="col-md-6">
                        <label for="serviceType" class="form-label">Service Type</label>
                        <input
                            type="text"
                            id="serviceType"
                            name="serviceType"
                            class="form-control"
                            value="<%= service.serviceType %>"
                            required>
                    </div>

                    <div class="col-md-6">
                        <label for="garage" class="form-label">Garage</label>
                        <input
                            type="text"
                            id="garage"
                            name="garage"
                            class="form-control"
                            value="<%= service.garage %>"
                            required>
                    </div>

                    <div class="col-md-6">
                        <label for="cost" class="form-label">Cost (₹)</label>
                        <input
                            type="number"
                            id="cost"
                            name="cost"
                            class="form-control"
                            min="0"
                            step="0.01"
                            value="<%= service.cost %>"
                            required>
                    </div>

                    <div class="col-md-6">
                        <label for="parts" class="form-label">Parts Replaced</label>
                        <input
                            type="text"
                            id="parts"
                            name="parts"
                            class="form-control"
                            value="<%= service.parts || '' %>">
                    </div>

                    <div class="col-12">
                        <label for="notes" class="form-label">Notes</label>
                        <textarea
                            id="notes"
                            name="notes"
                            class="form-control"
                            required><%= service.notes %></textarea>
                    </div>

                    <div class="col-12">
                        <label for="invoice" class="form-label">Invoice Details</label>
                        <input
                            type="text"
                            id="invoice"
                            name="invoice"
                            class="form-control"
                            value="<%= service.invoice %>"
                            required>
                    </div>

                </div>

                <div class="form-actions">
                    <a href="/services/history/<%= service.vehicle %>"
                       class="btn cancel-button">
                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn save-button">
                        <i class="bi bi-check2-circle me-1"></i>
                        Update Service
                    </button>
                </div>

            </form>

        </div>

    </main>

</body>
</html>
