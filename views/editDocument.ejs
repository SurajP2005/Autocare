<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Document | AutoCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">
    <h2 class="mb-4">Edit Document</h2>

    <form action="/documents/<%= document._id %>/edit" method="POST">

        <div class="mb-3">
            <label class="form-label">Vehicle</label>
            <input type="text" class="form-control"
                   value="<%= vehicle.brand %> <%= vehicle.model %> (<%= vehicle.year %>)"
                   disabled>
        </div>

        <div class="mb-3">
            <label class="form-label">Document Title</label>
            <input type="text" name="title" class="form-control"
                   value="<%= document.title %>" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Document Type</label>
            <select name="documentType" class="form-select" required>
                <% const types = ["Insurance", "Registration Certificate", "PUC", "Service Invoice", "Warranty", "Other"]; %>

                <% types.forEach(type => { %>
                    <option value="<%= type %>"
                        <%= document.documentType === type ? "selected" : "" %>>
                        <%= type %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Issue Date</label>
            <input type="date" name="issueDate" class="form-control"
                   value="<%= document.issueDate ? new Date(document.issueDate).toISOString().slice(0, 10) : '' %>">
        </div>

        <div class="mb-3">
            <label class="form-label">Expiry Date</label>
            <input type="date" name="expiryDate" class="form-control"
                   value="<%= document.expiryDate ? new Date(document.expiryDate).toISOString().slice(0, 10) : '' %>">
        </div>

        <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea name="notes" class="form-control" rows="3"><%= document.notes || "" %></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Update Document</button>
        <a href="/documents/history/<%= vehicle._id %>" class="btn btn-secondary">Cancel</a>

    </form>
</div>

</body>
</html>